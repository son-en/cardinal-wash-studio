# Local dev: a local libSQL file, zero config.
# Production: a Turso URL, e.g. libsql://cardinal-wash-studio-<org>.turso.io
DATABASE_URL="file:./data/dev.db"

# Only required when DATABASE_URL points at a remote Turso database.
# DATABASE_AUTH_TOKEN=""

# Long random string used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="dev-only-change-me-in-production-use-a-long-random-string-min-32-chars"

NODE_ENV="development"

# Optional — only read by `npm run db:seed`.
# SEED_ADMIN_EMAIL="admin@cardinalwash.studio"
# SEED_ADMIN_PASSWORD="change-me"
